# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://talos_api:talos_api_dev@localhost:5432/talos_dev
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=

# Najiz worker (npm run najiz). Needs WORKER_DATABASE_URL too, and Chromium.
NAJIZ_URL=https://najiz.sa
NAJIZ_NAFATH_SECONDS=180
NAJIZ_STALE_MINUTES=5
NAJIZ_POLL_SECONDS=3

# The public website's contact form (Phase 7): where the website is, and the inbox that gets the messages.
SITE_URL=https://debt.talosksa.com
CONTACT_INBOX=

# Sign-up (7.5): days of free trial, and how many of the first companies get the founding offer (0 turns it off).
TRIAL_DAYS=14
FOUNDING_LIMIT=10

# Subscription payments (7.6). none, fake (development only) or moyasar.
# Moyasar: test keys (sk_test_, pk_test_) outside production; live keys only in production, from the secret manager.
# The webhook secret is the one set on the webhook in Moyasar's dashboard (at least 24 characters).
PAYMENT_DRIVER=none
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
# The prices: the same file as the website's, kept outside the repository.
PRICING_FILE=

# Tax invoices (7.8). Made only once SELLER_VAT_NUMBER is set (Talos registered for VAT),
# and then every SELLER_ detail is needed: they are printed on every invoice.
# ZATCA_MODE: off (made but not sent, before Talos is connected to Fatoora), fake (development),
# sandbox or simulation (ZATCA's test systems), core (the real one, production only).
# ZATCA_CSID_TOKEN and ZATCA_CSID_SECRET come from `npm run zatca:onboard` and go in the secret manager.
ZATCA_MODE=off
ZATCA_CSID_TOKEN=
ZATCA_CSID_SECRET=
SELLER_NAME=مؤسسة حسن احمد المصوعي للمقاولات
SELLER_VAT_NUMBER=
SELLER_CR=
SELLER_BUILDING=
SELLER_STREET=
SELLER_DISTRICT=الفيصلية
SELLER_CITY=جدة
SELLER_POSTAL=45322
INVOICE_PREFIX=TLS

# Website (site/): Talos's details on the terms of use and the privacy policy (Sal, 26 November 2026).
LEGAL_NAME=مؤسسة حسن احمد المصوعي للمقاولات
LEGAL_CR=
LEGAL_ADDRESS=Al Faisaliyah, Jeddah 45322
LEGAL_ADDRESS_AR=حي الفيصلية، جدة 45322
PRIVACY_EMAIL=info@talosksa.com
